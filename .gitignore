# UBA monorepo .gitignore
#
# Deliberately PRECISE. This repo mixes Python and a Node/TypeScript frontend,
# so we avoid broad patterns (a bare `lib/`, `build/`, `dist/`, ...) that the
# generic Python template uses — those would silently swallow real source, such
# as the frontend's `uba/frontend/lib/` folder. Only genuinely generated files
# and secrets are ignored here; everything a student needs to read or run is
# committed.

# --- Python: bytecode & tool caches (regenerated automatically) ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/

# --- Node / Next.js (uba/frontend) — installed or built, never committed ---
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
# copied from node_modules at build time by scripts/copy-map-worker.mjs
uba/frontend/public/maplibre-gl-worker.mjs

# --- Databases created & seeded at runtime (the apps rebuild them) ---
*.db
*.sqlite3

# --- Secrets — note the example file IS kept ---
.env
.env.*
!.env.example

# --- Test / coverage output ---
.coverage
htmlcov/
coverage/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
