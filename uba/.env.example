# Copy this file to .env and change the values. Docker Compose reads .env
# automatically. The stack also runs without it, using demo defaults.
#
# NEVER commit a real .env file. It is listed in .gitignore.

# Port the site is served on. Change it if port 80 is already in use,
# and set UBA_PUBLIC_URL to match (for example http://localhost:8088).
HTTP_PORT=80
UBA_PUBLIC_URL=http://localhost

UBA_ENVIRONMENT=development

# Signs login tokens. Generate one with:  openssl rand -hex 32
UBA_JWT_SECRET=change-me-in-production-with-a-long-random-value

POSTGRES_USER=uba
POSTGRES_PASSWORD=uba-dev-password
POSTGRES_DB=uba

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
